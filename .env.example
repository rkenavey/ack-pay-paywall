# Server configuration, read once at startup. Copy to .env (which git ignores)
# and fill in the values. Never commit .env: it holds private keys and tokens.

# Port the server listens on. Default 8787.
PORT=8787

# The server's public origin. The payment service URL that payment options
# name is this plus /payment-service. Default http://localhost:8787.
PUBLIC_BASE_URL=http://localhost:8787

# The only browser origin CORS allows (the client page). Default http://localhost:5173.
CLIENT_ORIGIN=http://localhost:5173

# Private JWKs, as one-line JSON, for the three signing identities. Required.
# Each is a did:key identity; its DID is derived from the key.
#   ACME_AGENT_JWK       the Acme server agent at /api
#   GLOBEX_AGENT_JWK     the Globex server agent at /partner
#   PAYMENT_SERVICE_JWK  the payment service, which also signs receipts
ACME_AGENT_JWK=
GLOBEX_AGENT_JWK=
PAYMENT_SERVICE_JWK=

# Comma-separated payee DIDs the spend policy allows paying. Required; an empty
# value denies every payment. Put the Acme DID here to allow the Acme resources.
POLICY_ALLOWED_COUNTERPARTIES=

# Payments above this amount, in US cents, wait for a human approver. Default 5000 ($50.00).
POLICY_APPROVAL_THRESHOLD_MINOR=5000

# Bearer token of the human approver. Required, at least 24 characters.
# Keep it secret: whoever holds it can approve payments.
APPROVER_TOKEN=

# How long a payment request stays payable, and how long a receipt stays
# valid after settlement, in seconds. Defaults 900 and 600.
PAYMENT_REQUEST_TTL_SECONDS=900
RECEIPT_TTL_SECONDS=600

# Offer the sandbox network, which settles in memory and moves no money: on or off. Default on.
SANDBOX_NETWORK=on

# Stripe test-mode keys. Optional, but set both or neither: the secret key
# starts sk_test_ or rk_test_, the publishable key pk_test_. Live-mode keys are
# refused. Without them no Stripe option is offered.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Signing secret for the Stripe webhook (whsec_...). Optional; without it the
# webhook route answers 503 and settlement is checked when the receipt is requested.
STRIPE_WEBHOOK_SECRET=

# Log format for the one-line-per-event log on stdout: pretty or json. Default pretty.
LOG_FORMAT=pretty

# Client (read by Vite from packages/client/.env or the environment): the
# server origin the page talks to. Default http://localhost:8787.
# VITE_API_BASE_URL=http://localhost:8787
